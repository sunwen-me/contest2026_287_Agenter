############################################################################
# chip/k1/Make.defs
#
# SPDX-License-Identifier: Apache-2.0
############################################################################

include common/Make.defs

CHIP_ASRCS += k1_head.S
CHIP_CSRCS += k1_start.c k1_irq.c k1_irq_dispatch.c
CHIP_CSRCS += k1_timerisr.c k1_console.c

ifeq ($(CONFIG_K1_PLIC),y)
CHIP_CSRCS += k1_plic.c
endif

ifneq ($(filter y,$(CONFIG_K1_EMAC) $(CONFIG_K1_FB) $(CONFIG_K1_SDIO) $(CONFIG_K1_USBDEV) $(CONFIG_USBHOST_XHCI_K1)),)
CHIP_CSRCS += k1_cache.c
endif

ifeq ($(CONFIG_K1_EMAC),y)
CHIP_CSRCS += k1_emac.c
endif

ifeq ($(CONFIG_K1_I2C),y)
CHIP_CSRCS += k1_i2c.c
endif

ifeq ($(CONFIG_K1_SPI),y)
CHIP_CSRCS += k1_spi.c
endif

ifeq ($(CONFIG_K1_SDIO),y)
CHIP_CSRCS += k1_sdio.c
endif

ifeq ($(CONFIG_K1_RTL8852BS2_BT),y)
CHIP_CSRCS += k1_bt_uart.c
endif

ifeq ($(CONFIG_K1_RTL8852BS2_GPL_BOOTSTRAP),y)
CHIP_CSRCS += k1_rtl8852bs_gpl.c
endif

ifeq ($(CONFIG_K1_PWM),y)
CHIP_CSRCS += k1_pwm.c
endif

ifeq ($(CONFIG_K1_WATCHDOG),y)
CHIP_CSRCS += k1_wdt.c
endif

ifeq ($(CONFIG_K1_FB),y)
CHIP_CSRCS += k1_fb.c
endif

ifeq ($(CONFIG_K1_USBDEV),y)
CHIP_CSRCS += k1_usbdev.c
endif

ifneq ($(filter y,$(CONFIG_K1_USB_PROBE) $(CONFIG_K1_USB_HOST_GLUE)),)
CHIP_CSRCS += k1_usb.c
endif
