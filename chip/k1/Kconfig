config K1_RTL8852BS2_FW_HEADER_PACKET_DIAGNOSTIC
	bool "Send one RTL8852BS2 firmware static-header H2C packet"
	default n
	depends on K1_RTL8852BS2_FW_H2C_TX_DIAGNOSTIC
	---help---
		Send exactly one fixed-address Function 1 CMD53 TX FIFO packet after
		re-entering the reversible WCPU firmware-download state. The packet is
		strictly limited to its 24-byte TX descriptor, 8-byte FWDL H2C header,
		and the 80-byte static header prefix from the GPL 8852B U2 NICCE image.
		It polls the FWDL-ready bit, then clears the CPU and download state on
		both success and failure. It cannot send firmware sections, a dynamic
		header, or a complete image; it does not register Wi-Fi or create a
		network device.

config K1_RTL8852BS2_FW_SECTION_PACKET_DIAGNOSTIC
	bool "Send first RTL8852BS2 firmware section packet"
	default n
	depends on K1_RTL8852BS2_FW_HEADER_PACKET_DIAGNOSTIC
	---help---
		Send exactly one bounded first packet from section zero of the GPL U2 NICCE
		image. It re-enters the WCPU firmware-download state, sends the 80-byte
		static header, waits for FWDL-ready, clears the H2C/C2H halt controls, and
		then sends only the first 2020-byte section packet with its 24-byte FWDL
		TX descriptor and four zero padding bytes. Both FIFO writes use
		fixed-address Function 1 CMD53 and
		the WCPU/firmware-download state is cleared on success or failure. It does
		not send a second section packet, a checksum, a complete image, or create
		a Wi-Fi MAC or network device.

config K1_RTL8852BS2_FW_SECTION0_TAIL_PACKET_DIAGNOSTIC
	bool "Send RTL8852BS2 28-byte post-first-packet probe"
	default n
	depends on K1_RTL8852BS2_FW_SECTION_PACKET_DIAGNOSTIC
	---help---
		After the static header and first 2020-byte section-zero packet, send
		exactly 28 source bytes at offset 0x884 from the GPL U2 NICCE image. This
		is a compatibility transport probe, not the end of section zero: the
		real section is 0x4f108 bytes. The WCPU/download state is cleared on
		success and failure. It neither completes a section nor checks firmware
		readiness, and it does not create a Wi-Fi MAC or network device.

config K1_RTL8852BS2_FW_SECTION0_SECOND_PACKET_DIAGNOSTIC
	bool "Send the second RTL8852BS2 firmware section-zero packet"
	default n
	depends on K1_RTL8852BS2_FW_SECTION_PACKET_DIAGNOSTIC
