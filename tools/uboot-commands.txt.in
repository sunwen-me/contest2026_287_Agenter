# MUSE Pi Pro K1 first-boot command sheet
#
# Host ELF size:       @ELF_SIZE@ bytes (@ELF_SIZE_HEX@)
# Host ELF SHA256:     @ELF_SHA256@
# Flat payload size:   @FLAT_SIZE@ bytes (@FLAT_SIZE_HEX@)
# Flat payload SHA256: @FLAT_SHA256@
# Wrapper size:        @WRAPPER_SIZE@ bytes
# Wrapper SHA256:      @WRAPPER_SHA256@
#
# Safety:
# - Keep the original bootable SD card available.
# - Do not run saveenv or replace bootcmd during first bring-up.
# - The real board path loads a flat NuttX payload at 0x11000000 and a
#   RAM-only wrapper at 0x12000000. It does not modify U-Boot environment.

setenv k1_wrapper_addr 0x12000000
setenv k1_flat_addr 0x11000000

# The real board uses eMMC bootfs mmc 2:5. Type PMIC_WDT exactly.
wdt dev PMIC_WDT
wdt stop
wdt dev watchdog@D4080000
wdt stop

ext4load mmc 2:5 ${k1_wrapper_addr} /musepi/k1-go-wrapper.bin
ext4load mmc 2:5 ${k1_flat_addr} /musepi/contest-nuttx-flat.bin

# The wrapper supplies a0=hart 0/a1=0 and jumps to 0x11000000.
go ${k1_wrapper_addr}
