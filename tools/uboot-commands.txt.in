# MUSE Pi Pro K1 first-boot command sheet
#
# Host ELF size:   @ELF_SIZE@ bytes (@ELF_SIZE_HEX@)
# Host ELF SHA256: @ELF_SHA256@
#
# Safety:
# - Keep the original bootable SD card available.
# - Do not run saveenv or replace bootcmd during first bring-up.
# - Load the ELF file at 0x12000000. bootelf places its PT_LOAD segments
#   beginning at 0x11000000.

setenv k1_elf_addr 0x12000000
setenv k1_elf_size @ELF_SIZE_HEX@

# Inspect the board before loading anything.
version
bdinfo
mmc list
mmc dev 0
part list mmc 0
help bootelf
help wdt

# Choose ONE load method after confirming the real device and partition.

# Reference dedicated SD layout: ext4 bootfs on mmc 0:5.
ext4ls mmc 0:5 /
ext4ls mmc 0:5 /musepi
ext4load mmc 0:5 ${k1_elf_addr} /musepi/nuttx

# Generic FAT alternative:
# fatls mmc 0:1 /
# fatload mmc 0:1 ${k1_elf_addr} nuttx

# TFTP alternative:
# setenv serverip <server-ip>
# setenv ipaddr <board-ip>
# tftpboot ${k1_elf_addr} nuttx

# Verify that the transferred byte count matches @ELF_SIZE@.
echo loaded=${filesize} expected=${k1_elf_size}

# If the hash command is available, compare its output with:
# @ELF_SHA256@
hash sha256 ${k1_elf_addr} ${k1_elf_size}

# Stop the two watchdogs used by the reference K1 U-Boot when these device
# names are present. If a command fails, record the output before continuing.
wdt dev PMIC_WDT
wdt stop
wdt dev watchdog@D4080000
wdt stop

# Start the ELF. This command does not persistently modify U-Boot variables.
bootelf -p ${k1_elf_addr}
