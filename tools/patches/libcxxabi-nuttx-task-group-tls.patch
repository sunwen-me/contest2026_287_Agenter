 namespace {
+#if defined(__NuttX__)
+    int key_slot_ = -1;
+    std::__libcpp_exec_once_flag key_slot_flag_ = _LIBCPP_EXEC_ONCE_INITIALIZER;
+    std::__libcpp_mutex_t key_mutex_ = _LIBCPP_MUTEX_INITIALIZER;
+
+    void create_key_slot_() {
+        key_slot_ = task_tls_alloc(nullptr);
+        if (key_slot_ < 0)
+            abort_message("cannot allocate NuttX task TLS slot for __cxa_get_globals()");
+    }
+
+    void _LIBCPP_TLS_DESTRUCTOR_CC destruct_(void *p) {
+        __free_with_fallback(p);
+    }
