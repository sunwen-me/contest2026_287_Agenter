+    std::__libcpp_tls_key task_group_key_() {
+        if (0 != std::__libcpp_execute_once(&key_slot_flag_, create_key_slot_))
+            abort_message("cannot initialize NuttX task TLS slot for __cxa_get_globals()");
+
+        if (0 != std::__libcpp_mutex_lock(&key_mutex_))
+            abort_message("cannot lock NuttX task TLS key for __cxa_get_globals()");
+
+        uintptr_t encoded_key = task_tls_get_value(key_slot_);
+        if (encoded_key == 0) {
+            std::__libcpp_tls_key key;
+            if (0 != std::__libcpp_tls_create(&key, destruct_))
+                abort_message("cannot create task-group key for __cxa_get_globals()");
+            encoded_key = static_cast<uintptr_t>(key) + 1;
+            if (0 != task_tls_set_value(key_slot_, encoded_key))
+                abort_message("cannot store task-group key for __cxa_get_globals()");
+        }
+
+        if (0 != std::__libcpp_mutex_unlock(&key_mutex_))
+            abort_message("cannot unlock NuttX task TLS key for __cxa_get_globals()");
+
+        return static_cast<std::__libcpp_tls_key>(encoded_key - 1);
+    }
