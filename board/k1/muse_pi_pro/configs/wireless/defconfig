# MUSE Pi Pro RTL8852BS2 electrical and transport bring-up profile.
#
# This is deliberately separate from nsh: it changes the wireless power
# sequence and runs a polled UART2 H5 link diagnostic.  It does not
# provide an RTL8852BS2 Wi-Fi MAC, Wi-Fi firmware, or Bluetooth firmware.

#include "../nsh/defconfig"

# SDH1 Wi-Fi electrical/pinmux initialization and non-destructive CMD5.
CONFIG_K1_SDIO=y
CONFIG_K1_SDIO_WIFI=y
CONFIG_K1_RTL8852BS2_WIFI=y

# UART2 H5 SYNC/CONFIG only. It is deliberately not registered as a generic
# H4 device, and no vendor firmware/configuration is included in this tree.
CONFIG_K1_RTL8852BS2_BT=y
CONFIG_K1_BT_UART_TX_TIMEOUT_USEC=100000
