# K1 MUSE Pi Pro eMMC validation configuration.
#
# This starts from the minimal serial NSH image and enables the initial
# SDH2 eMMC path: 1-bit, polling, PIO, and read-only access.

#include "../nsh/defconfig"

CONFIG_MMCSD=y
CONFIG_MMCSD_MMCSUPPORT=y
CONFIG_MMCSD_SDIO=y
CONFIG_MMCSD_READONLY=y
# Keep the first multi-block validation bounded to two sectors.  This makes
# the read-only profile exercise CMD23 + CMD18 without turning an early PIO
# bring-up into an unbounded transfer.
CONFIG_MMCSD_MULTIBLOCK_LIMIT=2
CONFIG_SDIO_WIDTH_D1_ONLY=y
CONFIG_SDIO_BLOCKSETUP=y
CONFIG_BCH=y
CONFIG_BCH_DEVICE_READONLY=y
CONFIG_BOARD_INITTHREAD_STACKSIZE=8192
CONFIG_SCHED_WORKQUEUE=y
CONFIG_SCHED_HPWORK=y
CONFIG_K1_SDIO=y
