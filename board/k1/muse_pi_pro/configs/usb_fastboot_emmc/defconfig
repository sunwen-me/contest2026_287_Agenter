# K1 MUSE Pi Pro USB Fastboot plus writable eMMC validation profile.
#
# This enables the NuttX fastbootd write path against explicit /dev/mmcsd0*
# nodes. It is not the vendor BootROM/Titan FDL protocol and must not be used
# until the target image layout and recovery image have been verified.

#include "../usb_fastboot/defconfig"

CONFIG_MMCSD=y
CONFIG_MMCSD_MMCSUPPORT=y
CONFIG_MMCSD_SDIO=y
CONFIG_MMCSD_READONLY=n
CONFIG_MMCSD_MULTIBLOCK_LIMIT=0
CONFIG_SDIO_WIDTH_D1_ONLY=y
CONFIG_SDIO_BLOCKSETUP=y
CONFIG_BCH=y
CONFIG_BCH_DEVICE_READONLY=n
CONFIG_SCHED_WORKQUEUE=y
CONFIG_SCHED_HPWORK=y
CONFIG_K1_SDIO=y
CONFIG_BOARD_INITTHREAD_STACKSIZE=8192
