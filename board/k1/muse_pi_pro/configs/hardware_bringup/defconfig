# K1 combined hardware bring-up configuration.
#
# This image combines the already validated GPIO/PLIC, EMAC0, I2C2, SPI3,
# and watchdog paths. PWM11 is intentionally kept in its separate profile
# until a physical waveform measurement is available.

#include "../nsh/defconfig"

# GPIO / PLIC edge interrupt validation.
CONFIG_K1_PLIC=y
CONFIG_K1_GPIO_IRQ=y

# EMAC0 / RTL8211F polling validation.
CONFIG_NET=y
CONFIG_NET_ETHERNET=y
CONFIG_NETDEVICES=y
CONFIG_NET_ICMP=y
CONFIG_NET_ICMP_SOCKET=y
CONFIG_NET_UDP=y
CONFIG_NET_SOCKOPTS=y
CONFIG_K1_UDP_ECHO=y
CONFIG_K1_UDP_ECHO_PORT=33333
CONFIG_K1_UDP_ECHO_PACKETS=4
CONFIG_K1_UDP_ECHO_STACKSIZE=8192
CONFIG_K1_EMAC=y
CONFIG_K1_EMAC_DMA_POLL_MSEC=10
CONFIG_NETDEV_PHY_IOCTL=y
CONFIG_SYSTEM_MDIO=y
CONFIG_SYSTEM_PING=y
CONFIG_SYSTEM_PING_STACKSIZE=4096
CONFIG_DEBUG_NET_INFO=y
CONFIG_DEBUG_NET_WARN=y
CONFIG_NET_ETH_PKTSIZE=1514
CONFIG_IOB_NBUFFERS=16
CONFIG_IOB_BUFSIZE=1536
CONFIG_IOB_ALIGNMENT=64
CONFIG_LIBC_SEM_MUTEX_NOINLINE=y

# I2C2 board EEPROM validation.
CONFIG_I2C=y
CONFIG_I2C_DRIVER=y
CONFIG_I2C_RESET=y
CONFIG_SYSTEM_I2CTOOL=y
CONFIG_I2CTOOL_MINBUS=2
CONFIG_I2CTOOL_MAXBUS=2
CONFIG_I2CTOOL_MINADDR=0x50
CONFIG_I2CTOOL_MAXADDR=0x50
CONFIG_I2CTOOL_DEFFREQ=100000
CONFIG_K1_I2C=y
CONFIG_K1_I2C2=y
CONFIG_K1_I2C_POLL_TIMEOUT_USEC=100000

# SPI3 loopback validation.
CONFIG_SPI=y
CONFIG_SPI_DRIVER=y
CONFIG_SYSTEM_SPITOOL=y
CONFIG_SPITOOL_MINBUS=3
CONFIG_SPITOOL_MAXBUS=3
CONFIG_SPITOOL_DEFFREQ=800000
CONFIG_SPITOOL_DEFMODE=0
CONFIG_SPITOOL_DEFWIDTH=8
CONFIG_SPITOOL_DEFWORDS=4
CONFIG_SPITOOL_STACKSIZE=4096
CONFIG_K1_SPI=y
CONFIG_K1_SPI3=y
CONFIG_K1_SPI_POLL_TIMEOUT_USEC=100000

# Safe watchdog start/keepalive/stop smoke.
CONFIG_WATCHDOG=y
CONFIG_K1_WATCHDOG=y
CONFIG_K1_WATCHDOG_SMOKE=y
